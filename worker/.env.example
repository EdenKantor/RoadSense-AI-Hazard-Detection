# ── Worker environment variables ──────────────────────────────────────────────
# Copy this file to worker/.env and adjust values as needed:
#   Copy-Item worker\.env.example worker\.env
#
# Every variable here maps 1:1 to a field on worker.config.WorkerSettings.
# Values shown are defaults — override only when necessary.

# ── Redis ───────────────────────────────────────────────────────────────────
# Must match REDIS_URL in backend/.env so the worker and backend share the
# same RQ queue ("roadsense") and the same pub/sub channel ("roadsense:pipeline").
REDIS_URL=redis://localhost:6380

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Must match backend/.env MONGODB_URL.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=roadsenseai

# ── YOLO model ──────────────────────────────────────────────────────────────
# Path to the YOLOv8 weights file, relative to the worker/ directory (or
# absolute). See weights/README.md for what this file is and how to verify it.
YOLO_WEIGHTS_PATH=../weights/model.pt

# Confidence threshold below which YOLO detections are discarded (0.0–1.0).
# Low floor catches partial pothole detections; downstream DBSCAN clustering and
# the cross-upload merge logic absorb the false positives.
YOLO_CONFIDENCE_THRESHOLD=0.20

# ── Frame sampling ──────────────────────────────────────────────────────────
# Extract one frame every N seconds of video. 0.5 = 2 frames per second.
FRAME_SAMPLE_INTERVAL_SECONDS=0.5

# ── DBSCAN consolidation ────────────────────────────────────────────────────
# Spatial clustering radius in meters. Detections within this radius are
# merged into a single pothole event.
DBSCAN_EPS_METERS=5.0

# Minimum number of raw detections required to form a cluster. 1 means
# singletons are kept (recommended for this pipeline).
DBSCAN_MIN_SAMPLES=1

# ── Output ──────────────────────────────────────────────────────────────────
# Where annotated preview frames are written. Relative to worker/.
OUTPUT_DIR=../output

# ── Multi-worker ────────────────────────────────────────────────────────────
# Number of RQ SimpleWorker subprocesses the supervisor will spawn. Each
# worker gets a distinct name (worker-1, worker-2, ...). Lower values reduce
# parallelism and CPU use; set to 1 for single-worker mode.
WORKER_COUNT=3

# ── Pipeline observability ──────────────────────────────────────────────────
# When true (default), the worker publishes tiny JSON events to the Redis
# pub/sub channel `roadsense:pipeline` at every stage boundary. Publish
# failures never break the pipeline — they are logged as warnings.
# Set to false to disable the pub/sub emission entirely (pipeline still runs).
ENABLE_OBSERVABILITY=true
