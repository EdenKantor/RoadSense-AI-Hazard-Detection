# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to backend/.env and adjust values as needed:
#   Copy-Item backend\.env.example backend\.env
#
# Every variable here maps 1:1 to a field on backend.app.config.Settings.
# Values shown are defaults — override only when necessary.

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Host + port of the MongoDB instance. When using docker-compose.yml from the
# project root, MongoDB is published on localhost:27017 (unchanged).
MONGODB_URL=mongodb://localhost:27017

# Logical database name inside MongoDB.
MONGODB_DB_NAME=roadsenseai

# ── JWT authentication ──────────────────────────────────────────────────────
# Sign & verify JWT access tokens.
# CRITICAL: Generate a real secret for any non-dev environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# A different SECRET_KEY invalidates every existing JWT, so rotate it any time
# a token may have leaked.
SECRET_KEY=DEVELOPMENT-ONLY-CHANGE-IN-PRODUCTION

# JWT signing algorithm. HS256 (HMAC-SHA256) is the default.
ALGORITHM=HS256

# Access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis / RQ ──────────────────────────────────────────────────────────────
# Connection URL for Redis. The Docker Compose infrastructure publishes Redis
# on host port 6380, which matches the bundled-Redis dev setup. Keep this in
# sync with worker/.env REDIS_URL.
REDIS_URL=redis://localhost:6380

# ── File storage ────────────────────────────────────────────────────────────
# Where citizen uploads (MP4 + GPX) are written. Path is relative to the
# backend/ directory (so `../uploads` = project-root/uploads/).
UPLOAD_DIR=../uploads

# ── Emergency fallback (OFF by default) ─────────────────────────────────────
# If true AND Redis/RQ is unreachable at upload time, the backend runs the
# heavy pipeline inline in a background thread. Not recommended in production
# — leave false so uploads fail fast when the queue is down.
ENABLE_EMERGENCY_FALLBACK=false

# ── CORS ────────────────────────────────────────────────────────────────────
# JSON-style list of allowed origins for browser CORS. The pydantic-settings
# loader accepts a JSON array or a single string.
CORS_ORIGINS=["http://localhost:5173"]

# ── Dev-only observability dashboard ────────────────────────────────────────
# When true, the dev-only router at /api/dev/observability/stream is mounted
# and a background Redis-pub/sub subscriber + 1s aggregator are started on
# app startup. Set to false for anything other than local development.
DEV_MODE=false
